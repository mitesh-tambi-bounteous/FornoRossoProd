{
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9843, 0.9647, 0.9373],
      "hex": "#fbf6ef"
    },
    "$description": "Page background — warm cream, like flour dust on a pizzeria counter."
  },
  "color-surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Elevated surface background for cards and inputs, set apart from the cream page background."
  },
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1647, 0.1059, 0.0706],
      "hex": "#2a1b12"
    },
    "$description": "Primary text color — near-black espresso brown. Passes WCAG AA (4.5:1+) against color-bg."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.4196, 0.3529, 0.3059],
      "hex": "#6b5a4e"
    },
    "$description": "Secondary/muted text, e.g. captions and helper copy."
  },
  "color-fg-inverse": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Text/icon color for use on top of dark or saturated backgrounds like the primary button."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.7843, 0.1765, 0.1451],
      "hex": "#C82D25"
    },
    "$description": "Brand primary — wood-fired-oven tomato red, used for main CTAs and emphasis."
  },
  "color-surface-inverse": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.0824, 0.0706, 0.0706],
      "hex": "#151212"
    },
    "$description": "Near-black inverse surface for the header, footer, and other dark sections."
  },
  "color-primary-hover": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.5608, 0.1176, 0.0902],
      "hex": "#8f1e17"
    },
    "$description": "Darker red for hover/active states on primary actions."
  },
  "color-secondary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2941, 0.498, 0.3216],
      "hex": "#4b7f52"
    },
    "$description": "Basil-green accent for secondary emphasis (e.g. fresh/veg callouts)."
  },
  "color-accent": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8902, 0.6275, 0.0314],
      "hex": "#e3a008"
    },
    "$description": "Golden crust/cheese accent used for badges and chips."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8941, 0.8392, 0.7647],
      "hex": "#e4d6c3"
    },
    "$description": "Default hairline border color for cards, inputs and dividers."
  },
  "color-shadow": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.7882, 0.7216, 0.6353],
      "hex": "#c9b8a2"
    },
    "$description": "Warm neutral tint used for drop shadows so elevation reads as warm, not cold gray."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Smallest spacing step — tight gaps like icon-to-label."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Compact spacing — chip/button internal vertical padding."
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Default control spacing — input padding, small gaps."
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Base spacing unit — button/card horizontal padding, stack gaps."
  },
  "space-5": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" },
    "$description": "Comfortable spacing — card padding, section gaps."
  },
  "space-6": {
    "$type": "dimension",
    "$value": { "value": 32, "unit": "px" },
    "$description": "Large spacing — between major layout sections."
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Small corner radius — form controls, tags."
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Medium corner radius — buttons."
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Large corner radius — cards and modals."
  },
  "radius-pill": {
    "$type": "dimension",
    "$value": { "value": 999, "unit": "px" },
    "$description": "Full pill radius — chips and badges."
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 14, "unit": "px" },
    "$description": "Small text — captions, chip labels, helper text."
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Body text size."
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 20, "unit": "px" },
    "$description": "Subheading text size."
  },
  "font-size-xl": {
    "$type": "dimension",
    "$value": { "value": 28, "unit": "px" },
    "$description": "Display heading size, e.g. hero title."
  },
  "border-width-thin": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "px" },
    "$description": "Default hairline border width."
  },
  "border-width-thick": {
    "$type": "dimension",
    "$value": { "value": 2, "unit": "px" },
    "$description": "Emphasized border width, e.g. focus states."
  },
  "line-height-tight": {
    "$type": "number",
    "$value": 1.2,
    "$description": "Unitless line-height for headings."
  },
  "line-height-normal": {
    "$type": "number",
    "$value": 1.5,
    "$description": "Unitless line-height for body copy."
  },
  "font-family-heading": {
    "$type": "fontFamily",
    "$value": "'Fraunces', Georgia, serif",
    "$description": "Display serif for headings, evokes a trattoria menu board."
  },
  "font-family-body": {
    "$type": "fontFamily",
    "$value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "$description": "Body sans-serif for legible UI text."
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400,
    "$description": "Regular body weight."
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$value": 600,
    "$description": "Semibold weight for labels and emphasis."
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700,
    "$description": "Bold weight for headings and CTAs."
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": {
      "color": "{color-shadow}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 3, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Subtle elevation for resting cards and chips."
  },
  "shadow-md": {
    "$type": "shadow",
    "$value": {
      "color": "{color-shadow}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 12, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Raised elevation for hovered cards and popovers."
  },
  "border-default": {
    "$type": "border",
    "$value": {
      "width": "{border-width-thin}",
      "style": "solid",
      "color": "{color-border}"
    },
    "$description": "Default hairline border applied to cards and inputs."
  },
  "gradient-hero": {
    "$type": "gradient",
    "$value": [
      { "color": "{color-primary}", "position": 0 },
      { "color": "{color-primary-hover}", "position": 1 }
    ],
    "$description": "Warm oven-glow gradient for hero banners."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Primary button fill."
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-fg-inverse}",
    "$description": "Primary button label color."
  },
  "button-primary-border": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Primary button border color."
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}",
    "$description": "Primary button corner radius."
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-surface}",
    "$description": "Secondary (outline) button fill."
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Secondary button label color."
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Secondary button border color."
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}",
    "$description": "Secondary button corner radius."
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}",
    "$description": "Default card fill."
  },
  "card-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Default card text color."
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Default card border color."
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}",
    "$description": "Default card corner radius."
  },
  "chip-default-background": {
    "$type": "color",
    "$value": "{color-accent}",
    "$description": "Default chip/badge fill."
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Default chip/badge text color."
  },
  "chip-default-radius": {
    "$type": "dimension",
    "$value": "{radius-pill}",
    "$description": "Chip/badge corner radius."
  },
  "field-default-background": {
    "$type": "color",
    "$value": "{color-surface}",
    "$description": "Default form control fill."
  },
  "field-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Default form control text color."
  },
  "field-default-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Default form control border color."
  },
  "field-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}",
    "$description": "Default form control corner radius."
  },
  "field-focus-border": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Form control border color when focused."
  }
}
